{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/warmup?tier=hot",             "schedule": "*/5 * * * *"   },
    { "path": "/api/warmup?tier=warm",            "schedule": "*/15 * * * *"  },
    { "path": "/api/warmup?tier=cold",            "schedule": "*/30 * * * *"  },
    { "path": "/api/warmup?tier=drilldown",       "schedule": "*/15 * * * *"  },
    { "path": "/api/installation-metrics",        "schedule": "*/10 * * * *"  },
    { "path": "/api/sales-rep-activity",          "schedule": "*/10 * * * *"  }
  ]
}
